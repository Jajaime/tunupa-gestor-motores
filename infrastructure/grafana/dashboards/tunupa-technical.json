    {
      "id": 11,
      "title": "Historial de alarmas (por fecha de inicio)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "tunupa_timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "tunupa_timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT a.started_at AS \"Inicio\", m.code AS \"Motor\", COALESCE(d.device_code, '—') AS \"Dispositivo\", a.alarm_type AS \"Tipo\", a.severity AS \"Severidad\", a.status AS \"Estado\", a.measured_value AS \"Valor\", a.threshold_value AS \"Umbral\", a.unit AS \"Unidad\", a.resolved_at AS \"Resolución\" FROM public.alarms a JOIN public.motors m ON m.id=a.motor_id LEFT JOIN public.devices d ON d.id=a.device_id WHERE $__timeFilter(a.started_at) AND ('${motor:raw}' = 'ALL' OR a.motor_id::text = '${motor:raw}') AND ('${device:raw}' = 'ALL' OR a.device_id::text = '${device:raw}') ORDER BY a.started_at DESC LIMIT 200",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Últimas mediciones en el rango",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "tunupa_timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "tunupa_timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (m.code, d.device_code, UPPER(t.measurement_type)) m.code AS \"Motor\", d.device_code AS \"Dispositivo\", UPPER(t.measurement_type) AS \"Variable\", t.value AS \"Último valor\", t.unit AS \"Unidad\", t.quality AS \"Calidad\", t.measured_at AS \"Medida el\" FROM public.telemetry t JOIN public.motors m ON m.id=t.motor_id JOIN public.devices d ON d.id=t.device_id WHERE $__timeFilter(t.measured_at) AND ('${motor:raw}' = 'ALL' OR t.motor_id::text = '${motor:raw}') AND ('${device:raw}' = 'ALL' OR t.device_id::text = '${device:raw}') ORDER BY m.code, d.device_code, UPPER(t.measurement_type), t.measured_at DESC LIMIT 100",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    }
