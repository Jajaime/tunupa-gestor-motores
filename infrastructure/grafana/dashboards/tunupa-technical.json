  "templating": {
    "list": [
      {
        "name": "motor",
        "label": "Motor",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "tunupa_timescaledb"
        },
        "query": "SELECT code || ' · ' || name AS __text, id::text AS __value FROM public.motors ORDER BY code",
        "refresh": 1,
        "includeAll": true,
        "allValue": "ALL",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "device",
        "label": "Dispositivo",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "tunupa_timescaledb"
        },
        "query": "SELECT device_code AS __text, id::text AS __value FROM public.devices WHERE ('${motor:raw}' = 'ALL' OR motor_id::text = '${motor:raw}') ORDER BY device_code",
        "refresh": 2,
        "includeAll": true,
        "allValue": "ALL",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
