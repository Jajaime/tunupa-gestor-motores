    {
      "id": 13,
      "title": "Motores con telemetría recibida (60 s)",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "tunupa_timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "tunupa_timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT t.motor_id)::double precision AS value FROM public.telemetry t WHERE t.received_at >= NOW() - INTERVAL '60 seconds' AND t.received_at <= NOW() AND ('${motor:raw}' = 'ALL' OR t.motor_id::text = '${motor:raw}') AND ('${device:raw}' = 'ALL' OR t.device_id::text = '${device:raw}')",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Cantidad de motores distintos con mensajes recibidos durante los últimos 60 segundos. Es una indicación de recepción reciente de datos, no una comprobación directa de enlace, y se calcula independientemente de motors.operational_status. El instante utilizado es received_at, no measured_at."
    },
    {
      "id": 5,
      "title": "Temperatura",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "tunupa_timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "tunupa_timescaledb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(t.measured_at, $__interval), AVG(t.value)::double precision AS \"Temperatura\" FROM public.telemetry t WHERE $__timeFilter(t.measured_at) AND ('${motor:raw}' = 'ALL' OR t.motor_id::text = '${motor:raw}') AND ('${device:raw}' = 'ALL' OR t.device_id::text = '${device:raw}') AND t.quality = 'GOOD' AND UPPER(t.measurement_type) = 'TEMPERATURE' GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "celsius"
        },
        "overrides": []
      }
    },
