          "rawSql": "SELECT COUNT(*)::double precision AS value FROM public.alarms a WHERE a.status IN ('ACTIVE','ACKNOWLEDGED') AND ('${motor:raw}' = 'ALL' OR a.motor_id::text = '${motor:raw}') AND ('${device:raw}' = 'ALL' OR a.device_id::text = '${device:raw}')",
