# Desarrollo local HTTP: el acceso publico/HTTPS se configurara en otra entrega.
:80 {
    encode zstd gzip

    @api path /api/v1 /api/v1/*
    handle @api {
        reverse_proxy api:3002
    }

    @socket path /socket.io /socket.io/*
    handle @socket {
        reverse_proxy api:3002
    }

    # Normalizar la URL base de Grafana para sus enlaces y recursos.
    redir /grafana /grafana/ 308

    # Grafana usa su propia autenticacion. Conservamos el prefijo /grafana/.
    handle /grafana/* {
        reverse_proxy grafana:3000
    }

    handle {
        reverse_proxy web:3000
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
}
