# Tunupa HTTPS publico: Caddy gestiona automaticamente TLS y redireccion HTTP.
# Activar SOLO despues de configurar DNS, firewall, accesos y credenciales.
{$CADDY_DOMAIN} {
    encode zstd gzip

    @api path /api/v1 /api/v1/*
    handle @api {
        reverse_proxy api:3002
    }

    @socket path /socket.io /socket.io/*
    handle @socket {
        reverse_proxy api:3002
    }

    redir /grafana /grafana/ 308

    # Grafana conserva su autenticacion independiente.
    handle /grafana/* {
        reverse_proxy grafana:3000
    }

    handle {
        reverse_proxy web:3000
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
}
