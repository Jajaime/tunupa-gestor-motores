# 18c2 SOLO EXPERIMENTO: no sustituye apps/api/Dockerfile de produccion.
# Node, npm y modulos nativos se preparan en Debian Trixie (glibc).
FROM node:24-trixie-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY nest-cli.json tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build

FROM node:24-trixie-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# argon2 necesita instalacion del modulo nativo; no usar --ignore-scripts.
RUN npm ci --omit=dev --no-audit --no-fund

# Mantiene glibc; elimina shell y gestores de paquetes del runtime.
# :nonroot existe oficialmente, pero fijamos UID 1000 para igualar el overlay.
FROM gcr.io/distroless/nodejs24-debian13:nonroot AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps --chown=1000:1000 /app/package.json ./package.json
COPY --from=deps --chown=1000:1000 /app/node_modules ./node_modules
COPY --from=build --chown=1000:1000 /app/dist ./dist
USER 1000:1000
EXPOSE 3002
# La imagen distroless ya define ENTRYPOINT a Node.js.
CMD ["dist/main.js"]
