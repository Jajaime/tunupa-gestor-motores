# Aplicación
NODE_ENV=development
APP_NAME=gestor-motores

# PostgreSQL / TimescaleDB
POSTGRES_DB=gestor_motores
POSTGRES_USER=gestor_app
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_LOCAL
POSTGRES_PORT=5432

# API
APP_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Grafana
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_PASSWORD_GRAFANA

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=CAMBIAR_PASSWORD_MQTT
MQTT_TELEMETRY_TOPIC=tunupa/v1/devices/+/telemetry
MQTT_STATUS_TOPIC=tunupa/v1/devices/+/status
