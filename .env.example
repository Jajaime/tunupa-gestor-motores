# Aplicación
NODE_ENV=development
APP_NAME=gestor-motores

# PostgreSQL / TimescaleDB
POSTGRES_DB=gestor_motores
POSTGRES_USER=gestor_app
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_LOCAL
POSTGRES_PORT=5432

# API
APP_PORT=3002
WEB_ORIGIN=http://localhost:8080

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:8080

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_PASSWORD_GRAFANA
GRAFANA_DB_PASSWORD=CAMBIAR_PASSWORD_GRAFANA_READER

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=CAMBIAR_PASSWORD_MQTT
MQTT_TELEMETRY_TOPIC=tunupa/v1/devices/+/telemetry
MQTT_STATUS_TOPIC=tunupa/v1/devices/+/status

# Autenticación (generar secretos distintos para cada ambiente)
AUTH_ACCESS_SECRET=CAMBIAR_POR_64_CARACTERES_ALEATORIOS
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Detección de silencio de telemetría
TELEMETRY_TIMEOUT_SECONDS=30
TELEMETRY_CHECK_INTERVAL_MS=5000

# Caddy - Desarrollo local WSL
CADDY_PORT=8080
CADDY_WSL_HOST=REEMPLAZAR_POR_IP_WSL
