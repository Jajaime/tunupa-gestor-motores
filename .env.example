# Aplicación
NODE_ENV=development
APP_NAME=gestor-motores

# PostgreSQL / TimescaleDB
POSTGRES_DB=gestor_motores
POSTGRES_USER=gestor_app
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_LOCAL
POSTGRES_PORT=5432

# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=gestor_motores
MQTT_PASSWORD=CAMBIAR_PASSWORD_MQTT

# API
API_PORT=3001

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Grafana
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_PASSWORD_GRAFANA